# =============================================================================
# SHOTTY - AI Video Generation Application
# =============================================================================
# This file contains all environment variables needed to run the application.
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# AI API Keys (Required)
# -----------------------------------------------------------------------------

# Fireworks AI API Key - For AI model inference
# Get your API key from: https://fireworks.ai/
FIREWORKS_API_KEY=""

# OpenAI API Key - For GPT models and embeddings
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# ElevenLabs API Key - For text-to-speech (if not using local TTS)
# Get your API key from: https://elevenlabs.io/
ELEVEN_LABS_API=""

# Pexels API Key - For stock images and videos
# Get your API key from: https://www.pexels.com/api/
PEXELS_API=""

# -----------------------------------------------------------------------------
# Redis Configuration (Required for Queue Processing)
# -----------------------------------------------------------------------------

# Redis hostname (use "cache" for Docker Compose, "localhost" for local dev)
REDIS_HOST="cache"

# Redis port (default: 6379)
REDIS_PORT="6379"

# Redis password (leave empty if no password is set)
REDIS_PASSWORD=""

# -----------------------------------------------------------------------------
# Database Configuration (Required)
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example: postgresql://shotty:password@localhost:5432/shotty_db
DATABASE_URL=""

# -----------------------------------------------------------------------------
# Whisper Configuration (Speech-to-Text)
# -----------------------------------------------------------------------------

# Whisper API URL - For audio transcription
# Default uses self-hosted whisper service in docker-compose
WHISPER_URL="http://whisper/v1/audio/transcriptions"

# Whisper model ID - Smaller models are faster but less accurate
# Options: openai/whisper-tiny, openai/whisper-base, openai/whisper-small
MODEL_ID="openai/whisper-tiny"

# Return timestamp format - "word" for word-level timestamps
RETURN_TIMESTAMPS="word"

# -----------------------------------------------------------------------------
# Text-to-Speech Configuration
# -----------------------------------------------------------------------------

# Use local TTS instead of ElevenLabs (true/false)
USE_TTS="false"

# Self-hosted TTS URL (if USE_TTS is true)
TTS_URL="http://whisper/v1/audio/speech"

# -----------------------------------------------------------------------------
# OpenAI Configuration (Optional)
# -----------------------------------------------------------------------------

# Use a proxy or alternative OpenAI-compatible API
# Examples:
#   - OpenRouter: https://openrouter.ai/api/v1
#   - Local LLM: http://localhost:1234/v1
OPENAI_BASE_PATH="https://openrouter.ai/api/v1"

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Queue name for job processing
QUEUE_NAME="shotty-production"

# Application mode: "dev" for development, "production" for production
APP_MODE="production"

# Node environment: "development" or "production"
NODE_ENV="production"

# Server port (default: 3000)
PORT="3000"

# Server host
HOST="0.0.0.0"

# Log level: "trace", "debug", "info", "warn", "error", "fatal"
LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# Optional: Supabase Configuration (if using Supabase for storage)
# -----------------------------------------------------------------------------

# Supabase project URL
# SUPABASE_URL=""

# Supabase anon/public key
# SUPABASE_ANON_KEY=""

# -----------------------------------------------------------------------------
# Security (Production)
# -----------------------------------------------------------------------------

# Enable CORS (comma-separated list of allowed origins)
# CORS_ORIGIN="https://yourdomain.com,https://www.yourdomain.com"

# Rate limiting (requests per minute per IP)
# RATE_LIMIT_MAX="100"

# Rate limiting window in milliseconds
# RATE_LIMIT_WINDOW="60000"
