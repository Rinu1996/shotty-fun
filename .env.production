# Production Environment Configuration
# Copy this file to .env and fill in your actual values

# API Keys (Required)
FIREWORKS_API_KEY=""
OPENAI_API_KEY=""
ELEVEN_LABS_API=""
PEXELS_API=""

# Database Configuration (Required)
DATABASE_URL="postgresql://username:password@localhost:5432/shotty_production"

# Redis Configuration (Required for queue processing)
REDIS_HOST="cache"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Whisper Configuration
WHISPER_URL="http://whisper/v1/audio/transcriptions"
MODEL_ID="openai/whisper-tiny"
USE_TTS="false"
TTS_URL="http://whisper/v1/audio/speech"

# OpenAI Configuration
OPENAI_BASE_PATH="https://api.openai.com/v1"

# Application Configuration
QUEUE_NAME="shotty-production"
APP_MODE="production"
RETURN_TIMESTAMPS="word"

# Security
NODE_ENV="production"
FASTIFY_LOG_LEVEL="info"

# Performance
MAX_WORKERS="4"
QUEUE_CONCURRENCY="2"