# ===========================================
# Shotty Production Environment Configuration
# ===========================================

# ===========================================
# REQUIRED API KEYS
# ===========================================
FIREWORKS_API_KEY="your_fireworks_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
ELEVEN_LABS_API="your_elevenlabs_api_key_here"
PEXELS_API="your_pexels_api_key_here"

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DATABASE_URL="postgresql://username:password@postgres:5432/shotty"

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_HOST="cache"
REDIS_PORT="6379"
REDIS_PASSWORD="your_redis_password_here"

# ===========================================
# WHISPER CONFIGURATION
# ===========================================
WHISPER_URL="http://whisper/v1/audio/transcriptions"
MODEL_ID="openai/whisper-tiny"

# ===========================================
# TEXT-TO-SPEECH CONFIGURATION
# ===========================================
USE_TTS="false"
TTS_URL="http://whisper/v1/audio/speech"

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================
OPENAI_BASE_PATH="https://openrouter.ai/api/v1"
QUEUE_NAME="shotty-prod"
APP_MODE="production"
RETURN_TIMESTAMPS="word"