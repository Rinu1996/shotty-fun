{
  "name": "shotty",
  "version": "1.0.0",
  "description": "Generate AI-powered videos from URLs or text using OpenAI, Fireworks, Whisper and ElevenLabs",
  "scripts": {
    "ui:dev": "pnpm run --filter ui dev",
    "api:dev": "pnpm run --filter api dev",
    "dev": "pnpm --stream -r run dev",
    "build": "pnpm --stream -r run build",
    "start": "cd apps/api && pnpm start",
    "test": "pnpm --stream -r run test",
    "lint": "pnpm --stream -r run lint",
    "clean": "pnpm --stream -r run clean",
    "postinstall": "cd apps/api && pnpm prisma generate"
  },
  "keywords": [
    "ai",
    "video",
    "generation",
    "openai",
    "whisper",
    "elevenlabs",
    "remotion",
    "fastify",
    "react"
  ],
  "author": "n4ze3m",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/n4ze3m/shotty-fun.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "npm-run-all": "^4.1.5"
  }
}